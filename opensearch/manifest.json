{
  "settings": {
    "analysis": {
      "analyzer": {
        "latin": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding"]
        },
        "old_french": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "french_stemmer", "asciifolding"]
        }
      },
      "filter": {
        "french_stemmer": {
          "type": "stemmer",
          "language": "light_french"
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "id": { "type": "keyword" },
      "collection_id": { "type": "keyword" },
      "title": {
        "type": "text",
        "fields": {
          "en": { "type": "text", "analyzer": "english" },
          "fr": { "type": "text", "analyzer": "french" },
          "ofr": { "type": "text", "analyzer": "old_french" },
          "la": { "type": "text", "analyzer": "latin" },
          "el": { "type": "text", "analyzer": "greek" },
          "it": { "type": "text", "analyzer": "italian" },
          "es": { "type": "text", "analyzer": "spanish" }
        }
      },
      "repository": { "type": "text" },
      "shelfmark": { "type": "text" },
      "date": { "type": "text" },
      "origin": { "type": "text" },
      "num_pages": { "type": "integer" },
      "languages": { "type": "keyword" },
      "description": { "type": "text" },
      "authors": { "type": "keyword" },
      "type": { "type": "keyword" },
      "current_location": { "type": "keyword" },
      "websites": { "type": "keyword" },
      "year_start": { "type": "integer" },
      "year_end": { "type": "integer" },
      "number_of_illustrations": { "type": "integer" },
      "material": { "type": "keyword" },
      "has_transcription": { "type": "boolean" }
    }
  }
}
