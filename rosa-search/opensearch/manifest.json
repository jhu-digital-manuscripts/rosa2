{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "char_filter": {
        "latin_char_normalizer": {
          "type": "mapping",
          "mappings_path": "analyzers/latin-charmap.txt"
        },
        "old_french_charmap": {
          "type": "mapping",
          "mappings": ["’=>'", "\u0092=>'", "\u009C=>oe"]
        },
        "underscore_to_space": {
          "type": "mapping",
          "mappings": ["_=> "]
        }
      },
      "analyzer": {
        "name": {
          "type": "custom",
          "char_filter": ["underscore_to_space"],
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding", "english_possessive_stemmer", "french_elision"]
        },
        "latin": {
          "type": "custom",
          "char_filter": ["latin_char_normalizer"],
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding", "latin_stemmer", "latin_v_to_u", "latin_j_to_i"]
        },
        "old_french": {
          "type": "custom",
          "char_filter": ["old_french_charmap"],
          "tokenizer": "standard",
          "filter": [
            "lowercase", "asciifolding", "old_french_elision",
            "old_french_u_to_v", "old_french_j_to_i", "old_french_y_to_i", "old_french_ou_to_o",
            "old_french_ier_to_er", "old_french_z_to_s",
            "french_stemmer"
          ]
        }
      },
      "filter": {
        "english_possessive_stemmer": {
          "type": "stemmer",
          "language": "possessive_english"
        },
        "french_elision": {
          "type": "elision",
          "articles_case": true,
          "articles": ["l", "m", "t", "qu", "n", "s", "j", "d", "c", "jusqu", "quoiqu", "lorsqu", "puisqu"]
        },
        "latin_stemmer": {
          "type": "stemmer_override",
          "rules_path": "analyzers/latin-stemmer-rules.txt"
        },
        "latin_v_to_u": {
          "type": "pattern_replace",
          "pattern": "v",
          "replacement": "u"
        },
        "latin_j_to_i": {
          "type": "pattern_replace",
          "pattern": "j",
          "replacement": "i"
        },
        "french_stemmer": {
          "type": "stemmer",
          "language": "light_french"
        },
        "old_french_elision": {
          "type": "elision",
          "articles_case": true,
          "articles": [
            "l", "m", "t", "n", "s", "j", "i", "g", "d", "c", "q", "k", "y",
            "qu", "jusqu", "iusqu", "puisqu", "quanqu", "desqu", "lorsqu", "quoiqu",
            "entr", "encontr", "contr"
          ]
        },
        "old_french_u_to_v": {
          "type": "pattern_replace",
          "pattern": "(?<=^|[aeiouy])u(?=[aeiouy])",
          "replacement": "v"
        },
        "old_french_j_to_i": {
          "type": "pattern_replace",
          "pattern": "j",
          "replacement": "i"
        },
        "old_french_y_to_i": {
          "type": "pattern_replace",
          "pattern": "y",
          "replacement": "i"
        },
        "old_french_ou_to_o": {
          "type": "pattern_replace",
          "pattern": "ou",
          "replacement": "o"
        },
        "old_french_ier_to_er": {
          "type": "pattern_replace",
          "pattern": "(?<=.{2}[^rt])i(e[rz]s?|ees?)$",
          "replacement": "$1"
        },
        "old_french_z_to_s": {
          "type": "pattern_replace",
          "pattern": "z$",
          "replacement": "s"
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "id": { "type": "keyword" },
      "collection_id": { "type": "keyword" },
      "label": {
        "type": "text",
        "copy_to": "label_suggest",
        "fields": {
          "keyword": { "type": "keyword" }
        }
      },
      "label_suggest": { "type": "search_as_you_type" },
      "title": {
        "type": "text",
        "fields": {
          "keyword": { "type": "keyword" },
          "en": { "type": "text", "analyzer": "english" },
          "fr": { "type": "text", "analyzer": "french" },
          "ofr": { "type": "text", "analyzer": "old_french" },
          "la": { "type": "text", "analyzer": "latin" },
          "el": { "type": "text", "analyzer": "greek" },
          "it": { "type": "text", "analyzer": "italian" },
          "es": { "type": "text", "analyzer": "spanish" }
        }
      },
      "repository": { "type": "text", "analyzer": "name" },
      "shelfmark": { "type": "text" },
      "date": { "type": "keyword" },
      "origin": { "type": "keyword" },
      "num_pages": { "type": "integer" },
      "languages": { "type": "keyword" },
      "description": { "type": "text" },
      "authors": { "type": "keyword" },
      "type": { "type": "keyword" },
      "current_location": { "type": "keyword" },
      "num_illustrations": { "type": "integer" },
      "material": { "type": "keyword" },
      "has_transcription": { "type": "boolean" },
      "thumbnail": { "type": "object", "enabled": false },
      "logo": { "type": "keyword" }
    }
  }
}
