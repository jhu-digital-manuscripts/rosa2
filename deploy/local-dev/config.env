# Local development environment configuration
# Copy this file to config.env and customize for your environment

# Path to the rosa archive directory (required)
# This should be an absolute path or relative to the deploy/local-dev directory
ROSA_ARCHIVE=../../../rosa-archive

# IIIF Image API configuration
# Version: 2 or 3
IMAGE_API_VERSION=2

# Base URL for the IIIF Image API server
# This is the production image server that hosts the actual images
IMAGE_BASE_URL=https://image.library.jhu.edu/iiif

# Local server ports
IIIF_SERVER_PORT=3000
OPENSEARCH_PORT=9200

# Opensearch URL to embed in the jhsearch.json service file
# Use a relative URL (/_search) so the rosa-viewer vite proxy can forward requests
# The vite dev server proxies /_search to localhost:9200
OPENSEARCH_URL=/_search
