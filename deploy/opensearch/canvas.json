{
  "settings": {
    "analysis": {
      "char_filter": {
        "strip_brackets": {
          "type": "pattern_replace",
          "pattern": "[\\[\\]]",
          "replacement": ""
        },
        "latin_char_normalizer": {
          "type": "mapping",
          "mappings_path": "analyzers/latin-charmap.txt"
        }
      },
      "analyzer": {
        "english_stripped": {
          "type": "custom",
          "char_filter": ["strip_brackets"],
          "tokenizer": "standard",
          "filter": ["lowercase", "english_possessive_stemmer", "english_stop", "english_stemmer"]
        },
        "french_stripped": {
          "type": "custom",
          "char_filter": ["strip_brackets"],
          "tokenizer": "standard",
          "filter": ["lowercase", "french_elision", "french_stop", "french_stemmer"]
        },
        "italian_stripped": {
          "type": "custom",
          "char_filter": ["strip_brackets"],
          "tokenizer": "standard",
          "filter": ["lowercase", "italian_elision", "italian_stop", "italian_stemmer"]
        },
        "greek_stripped": {
          "type": "custom",
          "char_filter": ["strip_brackets"],
          "tokenizer": "standard",
          "filter": ["lowercase", "greek_stop", "greek_stemmer"]
        },
        "spanish_stripped": {
          "type": "custom",
          "char_filter": ["strip_brackets"],
          "tokenizer": "standard",
          "filter": ["lowercase", "spanish_stop", "spanish_stemmer"]
        },
        "german_stripped": {
          "type": "custom",
          "char_filter": ["strip_brackets"],
          "tokenizer": "standard",
          "filter": ["lowercase", "german_stop", "german_normalization", "german_stemmer"]
        },
        "latin": {
          "type": "custom",
          "char_filter": ["strip_brackets", "latin_char_normalizer"],
          "tokenizer": "standard",
          "filter": ["lowercase", "latin_stemmer", "asciifolding"]
        },
        "old_french": {
          "type": "custom",
          "char_filter": ["strip_brackets"],
          "tokenizer": "standard",
          "filter": ["lowercase", "old_french_stemmer", "asciifolding"]
        }
      },
      "filter": {
        "english_possessive_stemmer": {
          "type": "stemmer",
          "language": "possessive_english"
        },
        "english_stop": {
          "type": "stop",
          "stopwords": "_english_"
        },
        "english_stemmer": {
          "type": "stemmer",
          "language": "english"
        },
        "french_elision": {
          "type": "elision",
          "articles_case": true,
          "articles": ["l", "m", "t", "qu", "n", "s", "j", "d", "c", "jusqu", "quoiqu", "lorsqu", "puisqu"]
        },
        "french_stop": {
          "type": "stop",
          "stopwords": "_french_"
        },
        "french_stemmer": {
          "type": "stemmer",
          "language": "light_french"
        },
        "italian_elision": {
          "type": "elision",
          "articles_case": true,
          "articles": ["c", "l", "all", "dall", "dell", "nell", "sull", "coll", "pell", "gl", "agl", "dagl", "degl", "negl", "sugl", "un", "m", "t", "s", "v", "d"]
        },
        "italian_stop": {
          "type": "stop",
          "stopwords": "_italian_"
        },
        "italian_stemmer": {
          "type": "stemmer",
          "language": "light_italian"
        },
        "greek_stop": {
          "type": "stop",
          "stopwords": "_greek_"
        },
        "greek_stemmer": {
          "type": "stemmer",
          "language": "greek"
        },
        "spanish_stop": {
          "type": "stop",
          "stopwords": "_spanish_"
        },
        "spanish_stemmer": {
          "type": "stemmer",
          "language": "light_spanish"
        },
        "german_stop": {
          "type": "stop",
          "stopwords": "_german_"
        },
        "german_normalization": {
          "type": "german_normalization"
        },
        "german_stemmer": {
          "type": "stemmer",
          "language": "light_german"
        },
        "latin_stemmer": {
          "type": "stemmer_override",
          "rules_path": "analyzers/latin-stemmer-rules.txt"
        },
        "old_french_stemmer": {
          "type": "stemmer",
          "language": "light_french"
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "id": { "type": "keyword" },
      "manifest_id": { "type": "keyword" },
      "collection_id": { "type": "keyword" },
      "iiif_image_id": { "type": "keyword" },
      "label": {
        "type": "text",
