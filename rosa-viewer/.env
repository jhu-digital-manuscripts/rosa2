# Environment-specific settings for the rosa-viewer site builds (sites/*).
#
# These are the local-dev defaults, matching local-dev/start.sh. Vite loads this
# file for `npm run dev` and `npm run build:sites`; values are substituted into
# sites/<site>/index.html as %VITE_ROSA_...% placeholders and can also be edited
# in the built index.html afterwards.
#
# Override per machine in .env.local (git-ignored), or per build with ordinary
# environment variables, e.g.
#   VITE_ROSA_IIIF_BASE_URL=https://example.org/viewer/iiif npm run build:sites -- aor

# IIIF Presentation API base URL. Must be absolute and match the --base-url
# given to `rosa-tool generate-iiif-pres` (without the trailing slash).
VITE_ROSA_IIIF_BASE_URL=http://localhost:3000/iiif

# IIIF Image API base URL, used for thumbnails and the header banner.
VITE_ROSA_IMAGE_BASE_URL=https://image.library.jhu.edu/iiif
